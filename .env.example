# VOYD settings. Every key is VOYD_ + the field name on VoydSettings, so the
# file and voyd/settings.py cannot drift apart without one of them being wrong.
#
#   cp .env.example .env
#
# Everything here is already the code's default: an unedited copy boots the
# service against the Atlas Local container in docker-compose.yml. The only
# key worth setting on purpose is VOYD_VOYAGE_API_KEY, and only when you want
# real embeddings -- the examples and the test suite use fake vectors, because
# what they demonstrate is the database and not the model.

# The namespace a request's Host header selects: {slug}.voyd.com
VOYD_DOMAIN=voyd.com
VOYD_HOST=0.0.0.0
VOYD_PORT=8000

# Atlas Local, as published by docker-compose on 27018. directConnection is
# required from the host: the deployment advertises its in-network hostname
# ("mongo"), which does not resolve out here, so a topology-discovering client
# times out. The compose file overrides this for the containerised service,
# where "mongo" is exactly what does resolve.
VOYD_MONGO_URI=mongodb://localhost:27018/?directConnection=true
VOYD_DB=voyd

# Only needed to *compute* embeddings. Search takes a vector, not an API key,
# so the engine never sees this -- and a deployment whose mongot can embed
# server-side (SearchSpec.auto_embed) does not need it at all.
VOYD_VOYAGE_API_KEY=vy-dev-key
VOYD_VOYAGE_MODEL=voyage-3

# Stamp a passcode guard onto new scopes. Off by default: the guard is a real
# read-path check, not decoration, and turning it on changes what every
# subsequent request must carry.
VOYD_REQUIRE_PASSCODE=false

# Signs the head of the refusal chain served by GET /v1/voids/{token}/proof.
# Unset means the chain is served unsigned and says so (`signed: false`). It
# is still tamper-evident either way -- verifying it is arithmetic over public
# data and needs no key. What a key adds is an attestation, for a verifier who
# trusts whoever holds it.
# VOYD_LEDGER_KEY=

# The first owner is open; after that, minting a key needs an existing one.
# Set false on a private instance to refuse new owners entirely.
VOYD_ALLOW_SIGNUP=true
