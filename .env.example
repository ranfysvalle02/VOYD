# --- VOYD runtime ----------------------------------------------------------
# The apex domain. Voyds live at {slug}.{VOYD_DOMAIN}.
# For local dev use "localhost" so http://auto.localhost:8000 resolves with no DNS.
VOYD_DOMAIN=localhost
VOYD_HOST=0.0.0.0
VOYD_PORT=8000

# --- MongoDB (the operating system) ----------------------------------------
# docker-compose publishes Atlas Local on 27018. directConnection is required
# from the host: the container advertises its in-network hostname.
VOYD_MONGO_URI=mongodb://localhost:27018/?directConnection=true
VOYD_DB=voyd

# --- Cloudflare R2 (S3-compatible blob storage) ----------------------------
# Secrets stay in this process, never in MongoDB.
VOYD_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
VOYD_R2_KEY_ID=r2-access-key
VOYD_R2_SECRET=r2-secret-key
VOYD_R2_BUCKET=voyd-blobs

# --- Voyage AI (embeddings) ------------------------------------------------
VOYAGE_API_KEY=vy-...
VOYAGE_MODEL=voyage-3

# --- Console ---------------------------------------------------------------
# Set false to close console signups once your own account exists.
VOYD_ALLOW_SIGNUP=true

# Seeds demo.{VOYD_DOMAIN}: a real storefront with a live queue that the
# console previews in an iframe. Set false to skip it entirely.
VOYD_DEMO=true

# --- Default guard policy stamped onto new voyds ---------------------------

VOYD_REQUIRE_PASSCODE=false
VOYD_MAX_DOWNLOADS=0   # 0 = no cap
